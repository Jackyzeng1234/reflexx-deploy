# 网站域名配置
# ⚠️ 部署到生产环境时，请将 localhost 替换为你的实际域名

# 开发环境
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 生产环境示例（取消注释并修改）
# NEXT_PUBLIC_SITE_URL=https://reactiontest.com
# NEXT_PUBLIC_SITE_URL=https://www.reactiontest.com

# 其他环境变量（如果需要）
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# 联系表单邮件配置
# ============================================

# Resend API Key - 用于发送联系表单邮件
# 获取方式: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# 联系邮箱接收地址 - 用户提交的表单将发送到此邮箱
# CONTACT_EMAIL=your-email@example.com
